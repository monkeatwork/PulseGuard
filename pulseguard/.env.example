# Copied to .env by config-everything. Every value has a working default;
# change only what you need.

# Host port for the dashboard (the only port PulseGuard publishes).
PULSEGUARD_PORT=3000

# Postgres/TimescaleDB credentials (internal to the Docker network).
POSTGRES_USER=pulseguard
POSTGRES_PASSWORD=pulseguard_dev_password
POSTGRES_DB=pulseguard

# Benchmark generator (offline tooling only).
RBA_ZENODO_RECORD_ID=6782156
PULSEGUARD_SEED=42
